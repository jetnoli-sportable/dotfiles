{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${WB_REVIEW_BIN:-$HOME/.config/scripts/tmux}/wb-review-hook.sh\" hook-prompt",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${WB_REVIEW_BIN:-$HOME/.config/scripts/tmux}/wb-turn-snapshot.sh\" prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${WB_REVIEW_BIN:-$HOME/.config/scripts/tmux}/wb-review-hook.sh\" hook-stop",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${WB_REVIEW_BIN:-$HOME/.config/scripts/tmux}/wb-turn-snapshot.sh\" stop",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${WB_REVIEW_BIN:-$HOME/.config/scripts/tmux}/wb-review-hook.sh\" hook-stop-failure",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${WB_REVIEW_BIN:-$HOME/.config/scripts/tmux}/wb-turn-snapshot.sh\" stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${WB_REVIEW_BIN:-$HOME/.config/scripts/tmux}/wb-review-hook.sh\" hook-session-start",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
