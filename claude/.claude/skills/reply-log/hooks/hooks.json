{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${REPLY_LOG_BIN:-$HOME/.config/scripts/tmux}/claude-reply-log.sh\" hook-stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${REPLY_LOG_BIN:-$HOME/.config/scripts/tmux}/claude-reply-log.sh\" hook-session-end",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
