  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/scripts/tmux/tasks-git-hooks/pretooluse-guard.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.config/scripts/tmux/risky-command-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/scripts/tmux/tasks-git-hooks/pretooluse-guard.sh"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/scripts/tmux/haircut-gate-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/scripts/tmux/haircut-gate-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/scripts/tmux/format-on-edit-hook.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
