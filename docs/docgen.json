{
  "templates": "docs/_templates",
  "pageDirs": ["docs", "docs/guides"],
  "hub": {
    "out": "docs/HUB.html",
    "eyebrow": "personal workflow",
    "title": "Hub",
    "intro": "Everything here is a note — and a task is a note labelled a task. This dashboard indexes every documented piece of the personal workflow; click a tile to open it, or press <kbd>prefix</kbd>+<kbd>h</kbd> in tmux. New here? Start with the <b>roadmap</b>, the <b>wb guide</b>, and <b>setup</b> below.",
    "groups": [
      {
        "key": "personal-workflow",
        "title": "Personal workflow",
        "sub": "~/code/dotfiles",
        "glyph": "◈"
      },
      {
        "key": "skills",
        "title": "Claude skills",
        "sub": "~/.claude/skills/ · stowed from claude/ in this repo · guides in docs/guides/",
        "glyph": "◆",
        "dense": true
      },
      {
        "key": "tuis",
        "title": "TUIs",
        "sub": "separate repos under ~/code/",
        "glyph": "▦"
      },
      {
        "key": "nvim",
        "title": "Nvim plugins",
        "sub": "nvim/.config/nvim/lua/ in this repo · guides in docs/guides/",
        "glyph": "◇"
      }
    ],
    "sidecar": [
      {
        "group": "personal-workflow",
        "title": "Task board",
        "tile": "Full HTML task board — lifecycle stepper, Pipeline tab, dependency/parent-child relationships, repo/family filters, Key Findings. Generated on demand, not auto-rebuilt: run `wb board --html` to refresh it.",
        "href": "../logs/board.html",
        "path": "logs/board.html",
        "chip": "on-demand"
      }
    ]
  },
  "index": {
    "out": "docs/INDEX.md",
    "sources": [
      { "kind": "tmux-binds", "path": "tmux/.config/tmux/tmux.conf", "tags": "tmux" },
      { "kind": "zsh", "path": "zsh/.zshrc", "tags": "zsh" },
      { "kind": "skills", "path": "claude/.claude/skills", "tags": "claude" },
      { "kind": "scripts", "path": "scripts/.config/scripts/tmux", "tags": "tmux" },
      { "kind": "scripts", "path": "scripts/.config/scripts", "tags": "shell" },
      { "kind": "doc", "path": "scripts/.config/scripts/tmux/instructions.md", "tags": "tmux" },
      { "kind": "doc", "path": "nvim/.config/nvim/instructions.md", "tags": "nvim" },
      { "kind": "decisions", "path": "logs/decisions", "tags": "" },
      { "kind": "memory", "path": "~/.claude/projects/-home-jetnoli-code-dotfiles/memory/MEMORY.md", "tags": "" },
      { "kind": "tui", "path": "~/code/notes-tui/README.md", "name": "notes-tui", "invoke": "notes", "guide": "docs/guides/notes-tui.html", "tags": "" },
      { "kind": "tui", "path": "~/code/replay-tui/README.md", "name": "replay-tui", "invoke": "replay", "guide": "docs/guides/replay-tui.html", "tags": "" },
      { "kind": "taskstore", "path": "~/code/tasks", "tags": "" }
    ]
  },
  "redact": {
    "denylist": ["be--monorepo", "frontend", "lib--algorithms", "terraform-gcp", "tool--*", "qa--tools", "docs--architecture"]
  }
}
