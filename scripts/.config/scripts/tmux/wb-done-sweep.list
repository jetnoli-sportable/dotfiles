# wb done sweep lists. One rule per line, `keep:<glob>` or `throwaway:<glob>`;
# blank lines and lines starting with `#` are ignored.
#   keep:       gitignored files `wb done` copies into the task's dossier
#   throwaway:  gitignored files it discards with the worktree
# Globs are gitignore-style: no `/` matches at any depth, an inner `/` matches
# the whole worktree-relative path, a trailing `/` matches a directory only.
# Anything matching neither list stops `wb done` until resolved with
# `--keep <path>` or `--throwaway <path>`. Credential-shaped files are never kept.
# Rules naming one repo's own paths go in ~/.config/wb/sweep.local.list (same
# format, never committed), so this file stays repo-agnostic.
keep:.claude-queue.md
keep:CLAUDE.local.md

throwaway:node_modules/
throwaway:dist/
throwaway:build/
throwaway:.venv/
throwaway:.pytest_cache/
throwaway:.mypy_cache/
throwaway:venv/
throwaway:__pycache__/
throwaway:target/
throwaway:coverage/
throwaway:logs/
throwaway:*.log
throwaway:.ruff_cache/
# Terraform downloads and lock file; `terraform init` rebuilds both. Only
# gitignored files are swept, so a repo that commits its lock file is unaffected.
throwaway:.terraform/
throwaway:.terraform.lock.hcl
# DVC's local cache, index and locks; `dvc pull` rebuilds them from the remote.
throwaway:.dvc/cache/
throwaway:.dvc/site-cache/
throwaway:.dvc/tmp/
