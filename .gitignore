# tpm-managed tmux plugins (reinstalled with prefix+I)
tmux/.config/tmux/plugins/

# absorbed nvim repo's old git history (renamed from .git during migration)
nvim/.config/nvim/.gitbakup/

# personal nvim scratch/notes
nvim/.config/nvim/improvements/

# editor/OS noise
*.swp
.DS_Store

# scratch (decision docs, command output)
logs/

# scratch (local task notes, not tracked)
scratch/

# per-worktree Claude queue scratch file (also registered per-repo in
# .git/info/exclude by wb_ensure_repo_ignore, scripts/.config/scripts/tmux/wb.sh —
# this tracked entry documents the rule for dotfiles' own worktrees)
.claude-queue.md

# worktrees (ce-worktree)
.worktrees/

# claude package: never track machine state or unaudited settings
claude/.claude/settings.json
claude/.claude/settings.local.json
claude/.claude/parked-items/
claude/.claude/projects/
